{
  "_comment_1": "이 설정을 .claude/settings.json (프로젝트) 또는 ~/.claude/settings.json (전역)에 병합하세요.",
  "_comment_2": "settings.local.json은 .gitignore에 추가하세요 — 시크릿·로컬 경로용.",
  "_comment_3": "{{...}} 자리는 사용자 답변(STEP 7 거버넌스, STEP 2 #7)으로 치환됩니다.",

  "permissions": {
    "allow": [
      "Read(./**)",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "{{도메인별 읽기 전용 도구 — 예: mcp__finance-db__query_readonly}}"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "{{STEP 7 블랙리스트 — 예: Bash(curl * | sh)}}",
      "{{외부 발송 차단 — 예: mcp__gmail__send_email}}",
      "{{DB 쓰기 차단 — 예: mcp__*__write, mcp__*__delete}}"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "_purpose": "STEP 2 #7 Policy/Governance — 위험 도구 실행 전 검증·차단",
        "matcher": "{{도구 패턴 — 예: Bash}}",
        "hooks": [
          {
            "type": "command",
            "command": "{{검증 스크립트 경로 — 예: $CLAUDE_PROJECT_DIR/.claude/scripts/preflight.sh}}"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_purpose": "감사 로그 — 모든 도구 호출을 JSONL로 append",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{로그 append 스크립트 — 예: $CLAUDE_PROJECT_DIR/.claude/scripts/audit.sh}}"
          }
        ]
      }
    ]
  },

  "env": {
    "_comment": "환경 변수가 필요하면 추가. 시크릿은 settings.local.json에",
    "{{ENV_VAR_NAME}}": "{{value}}"
  }
}
